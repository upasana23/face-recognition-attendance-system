# Application Settings
APP_NAME="SmartFace Attendance System"
PORT=8000
HOST="0.0.0.0"

# Recognition Thresholds
# LBPH distance: lower is a better match. Typical matches are < 75.0. Above 75.0 is rejected as unknown.
CONFIDENCE_THRESHOLD=75.0
SAMPLES_PER_STUDENT_DEFAULT=15

# Database URL
DATABASE_URL="sqlite:///./backend/data/attendance.db"
